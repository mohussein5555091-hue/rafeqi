# Copy to .env (npm run setup does this and fills in a random secret).
# Never commit .env.

RAFEQI_ENV=development
# Long random string used to sign session tokens.
RAFEQI_SECRET_KEY=replace-me
# Leave unset to use the SQLite file data/rafeqi.db.
# For PostgreSQL later: postgresql+psycopg://user:password@localhost:5432/rafeqi
# RAFEQI_DATABASE_URL=

# ── Online (Render; see docs/DEPLOY.md) ──
# Sign-up needs this code when set (give it to your friends). Leave unset for open sign-up.
# RAFEQI_INVITE_CODE=
# Where progress photos live: disk (data/uploads/, the default) or database (hosts that wipe the disk on deploy).
# RAFEQI_PHOTO_STORAGE=disk

# ── AI (off unless both are set; nothing else changes when it's off) ──
# RAFEQI_AI_ENABLED=true
# ANTHROPIC_API_KEY=
# Optional: RAFEQI_AI_MODEL_PLAN, RAFEQI_AI_MODEL_REVIEW, RAFEQI_AI_RUNS_PER_WEEK (2), RAFEQI_AI_MONTHLY_LIMIT_USD (5)
