# Copy to .env (npm run setup does this and fills in a random secret).
# Never commit .env.

RAFEQI_ENV=development
# Long random string used to sign session tokens.
RAFEQI_SECRET_KEY=replace-me
# Leave unset to use the SQLite file data/rafeqi.db.
# For PostgreSQL later: postgresql+psycopg://user:password@localhost:5432/rafeqi
# RAFEQI_DATABASE_URL=
